#!/usr/bin/env bash
# Installs and configures HAProxy on a new Ubuntu machine to load
# balance traffic between web-01 and web-02 using a roundrobin algorithm

apt-get update -y
apt-get install -y haproxy

# Enable HAProxy to be managed via the init script
sed -i "s/ENABLED=0/ENABLED=1/" /etc/default/haproxy

# Backup original config
cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak

# Append frontend/backend configuration for load balancing
cat >> /etc/haproxy/haproxy.cfg << 'HAPROXY_CONFIG'

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server 6996-web-01 54.91.248.231:80 check
    server 6996-web-02 100.27.23.115:80 check
HAPROXY_CONFIG

service haproxy restart
